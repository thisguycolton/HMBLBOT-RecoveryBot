<?xml version="1.0" encoding="utf-8"?>
<!-- A widget style's background (WidgetStyles.java), for the day count and the chip: its color, then its drawing.
     The widget's root clips the drawing to the rounded corners (clipToOutline, Android 12 and up). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5EFE3" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:top="18dp">
        <bitmap android:src="@drawable/widget_tile_rule" android:tileMode="repeat" android:tint="#143B2E21" />
    </item>
    <item android:gravity="start|fill_vertical" android:width="1dp" android:left="10dp">
        <shape android:shape="rectangle"><solid android:color="#73B86B29" /></shape>
    </item>
</layer-list>
