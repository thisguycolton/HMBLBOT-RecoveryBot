<?xml version="1.0" encoding="utf-8"?>
<!-- A widget style's background (WidgetStyles.java), for the day count and the chip: its color, then its drawing.
     The widget's root clips the drawing to the rounded corners (clipToOutline, Android 12 and up). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="160dp" android:centerX="0.5" android:centerY="0.45" android:startColor="#FFFFFF" android:endColor="#E3E3DE" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:gravity="start|fill_vertical" android:width="5dp">
        <shape android:shape="rectangle"><solid android:color="#3B70A6" /></shape>
    </item>
</layer-list>
