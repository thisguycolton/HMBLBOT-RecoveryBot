<?xml version="1.0" encoding="utf-8"?>
<!-- A widget style's background (WidgetStyles.java), for the day count and the chip: its color, then its drawing.
     The widget's root clips the drawing to the rounded corners (clipToOutline, Android 12 and up). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="160dp" android:centerX="0.5" android:centerY="0.45" android:startColor="#2980D9" android:endColor="#08336E" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_orn_waves" android:gravity="bottom|fill_horizontal" android:height="52dp" />
</layer-list>
