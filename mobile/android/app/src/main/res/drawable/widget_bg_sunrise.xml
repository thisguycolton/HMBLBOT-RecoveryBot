<?xml version="1.0" encoding="utf-8"?>
<!-- A widget style's background (WidgetStyles.java), for the day count and the chip: its color, then its drawing.
     The widget's root clips the drawing to the rounded corners (clipToOutline, Android 12 and up). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F97316" android:endColor="#DB2777" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_orn_sun" android:gravity="bottom|end" android:width="190dp" android:height="190dp" android:bottom="-91dp" android:right="-91dp" />
</layer-list>
