<?xml version="1.0" encoding="utf-8"?>
<!-- A widget style's background (WidgetStyles.java), for the day count and the chip: its color, then its drawing.
     The widget's root clips the drawing to the rounded corners (clipToOutline, Android 12 and up). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="160dp" android:centerX="0.5" android:centerY="0.45" android:startColor="#333338" android:endColor="#17171A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_orn_rings" android:gravity="top|end" android:width="190dp" android:height="190dp" android:top="-95dp" android:right="-95dp" />
</layer-list>
