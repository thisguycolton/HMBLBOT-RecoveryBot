<?xml version="1.0" encoding="utf-8"?>
<!-- A widget style's background (WidgetStyles.java), for the day count and the chip: its color, then its drawing.
     The widget's root clips the drawing to the rounded corners (clipToOutline, Android 12 and up). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#5C8CBA" android:endColor="#2C4F78" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_orn_glow" android:gravity="top|end" android:width="220dp" android:height="220dp" android:top="-140dp" android:right="-104dp" />
</layer-list>
