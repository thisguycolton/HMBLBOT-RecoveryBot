#!/usr/bin/env node
// Writes the widgets' layouts (app/javascript/lib/widgetLayouts.js) into the iPhone and Android
// apps, which draw their Home Screen widgets from them. Run after changing the layouts; the apps
// pick up the change in their next build.
//
//   bin/widget-layouts
const fs = require("fs");
const path = require("path");
const { pathToFileURL } = require("url");

const root = path.resolve(__dirname, "..");
const targets = [
  "mobile/ios/App/RecoveryBotWidgets/Layouts/widget-layouts.json",
  "mobile/android/app/src/main/assets/widget-layouts.json",
];

(async () => {
  const { allLayouts } = await import(pathToFileURL(path.join(root, "app/javascript/lib/widgetLayouts.js")).href);
  const json = `${JSON.stringify(allLayouts())}\n`;
  for (const target of targets) {
    const file = path.join(root, target);
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(file, json);
    console.log(`${target} (${Math.round(json.length / 1024)} KB)`);
  }
})();
