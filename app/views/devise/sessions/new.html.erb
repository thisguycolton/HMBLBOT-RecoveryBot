<%= render "devise/shared/auth_page", page: "login", title: "Log in", props: {
      action: session_path(resource_name),
      email: resource.email.to_s,
      remember: devise_mapping.rememberable? && !native_app?,
      always_remember: native_app?, # it's their phone: the app keeps them signed in
      forgot_path: (new_password_path(resource_name) if devise_mapping.recoverable?),
      sign_up_path: (new_registration_path(resource_name) if devise_mapping.registerable?),
      confirm_path: (new_confirmation_path(resource_name) if devise_mapping.confirmable?),
      google_path: (GoogleSignIn.path unless native_app?), # Google blocks its sign-in page inside apps
      apple_path: (AppleSignIn.path unless native_platform == "ios"), # the iPhone app uses Apple's own sheet
      native_sign_in: (NativeSignIn.options(native_platform) if native_app?), # the apps' own Google and Apple sheets
    } %>
