<% content_for(:page_title) { "Log in | HumbleBot" } %>
<%# React login page (app/javascript/components/auth/LoginPage.jsx). It posts a plain
    form, so Devise's redirects, remember-me and flash messages work as before. %>
<%# w-full: the reader styles make <body> a centring flexbox %>
<div id="login-page" class="w-full"
     data-props="<%= {
       action: session_path(resource_name),
       authenticity_token: form_authenticity_token,
       email: resource.email.to_s,
       remember: devise_mapping.rememberable?,
       forgot_path: (new_password_path(resource_name) if devise_mapping.recoverable?),
       sign_up_path: (new_registration_path(resource_name) if devise_mapping.registerable?),
     }.to_json %>"></div>
<%= vite_javascript_tag "login.jsx" %>
