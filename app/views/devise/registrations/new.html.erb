<%= render "devise/shared/auth_page", page: "sign_up", title: "Sign up", props: {
      action: registration_path(resource_name),
      name: resource.name.to_s,
      email: resource.email.to_s,
      min_password_length: @minimum_password_length,
      login_path: new_session_path(resource_name),
      human_check: HumanCheck.fields,
      google_path: (GoogleSignIn.path unless native_app?), # Google blocks its sign-in page inside apps
      apple_path: (AppleSignIn.path unless native_platform == "ios"), # the iPhone app uses Apple's own sheet
      native_sign_in: (NativeSignIn.options(native_platform) if native_app?), # the apps' own Google and Apple sheets
    } %>
