<%# Dark mode and the folded sidebar, set before the page draws (useTheme / useRail in
    shell/useShell.js set them again once React is up). Without this every page load flashed
    the light theme first. %>
<script>
  try {
    var t = localStorage.getItem("theme") || "system";
    var dark = t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    if (dark) document.documentElement.classList.add("dark");
    if (localStorage.getItem("hb-nav-rail") === "1") document.documentElement.classList.add("side-rail");
  } catch (e) {}
</script>
