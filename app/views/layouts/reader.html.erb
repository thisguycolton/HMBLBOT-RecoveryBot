<!-- app/views/layouts/reader.html.erb -->
<!DOCTYPE html>
<html>

<head>
  <title>
    <%= content_for(:page_title) || "| HUMBLEBOT |" %>
  </title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%= csrf_meta_tags %>
  <%= vite_client_tag %>
  <%= vite_react_refresh_tag if Rails.env.development? %>

  <%= render 'application/favicon' %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400..800;1,400..800&display=swap">

</head>

<script>
  (function () {
    var KEY = 'theme'; // must match your toggle
    var pref = localStorage.getItem(KEY) || 'system';
    var sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var isDark = pref === 'dark' || (pref === 'system' && sysDark);

    document.documentElement.classList.toggle('dark', isDark);

    // (optional) keep <meta name="theme-color"> in sync
    var meta = document.querySelector('meta[name="theme-color"]') || (function () {
      var m = document.createElement('meta');
      m.name = 'theme-color';
      document.head.appendChild(m);
      return m;
    })();
    meta.content = isDark ? '#0a0a0a' : '#ffffff';
  })();
</script>
<body data-layout="reader" class="min-h-screen bg-stone-100 text-slate-900 dark:bg-stone-800 dark:text-neutral-100" data-current-user="<%= user_signed_in? %>" data-suite-admin="<%= user_signed_in? && current_user.suite_admin? %>" data-admin="<%= user_signed_in? && current_user.admin? ? "true" : "false" %>">
  <%= yield %>
  <%= render "application/toasts" %>
</body>

</html>