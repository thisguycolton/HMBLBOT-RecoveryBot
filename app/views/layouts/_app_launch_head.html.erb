<%# The apps' loading screen: on the first page after the app opens, the robot from the launch
    screen stays in the middle of the screen, shimmering (like the shell's skeleton logo), until the
    page and everything it needs have loaded; native_app.js then fades it away (finishLaunch). The
    app's own launch screen hands over to it, so there's no blank or half-drawn page in between.
    Later pages in the same run skip it (sessionStorage hb-launched). Only in the apps. %>
<% if native_app? %>
<style>
  #app-launch { display: none; }
  .app-launching #app-launch {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 2147483000;
    background: #f5f5f4; transition: opacity .35s ease;
    animation: app-launch-give-up 0s 10s forwards; /* never stuck, even if native_app.js didn't load */
  }
  @media (prefers-color-scheme: dark) { .app-launching #app-launch { background: #292524; } }
  .app-launching #app-launch.app-launch-done { opacity: 0; pointer-events: none; }
  #app-launch i {
    display: block; width: 112px; aspect-ratio: 5 / 4;
    -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%2080%22%3E%3Cdefs%3E%3Cmask%20id%3D%22m%22%3E%3Crect%20width%3D%22100%22%20height%3D%2280%22%20fill%3D%22white%22%2F%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%2242%22%20r%3D%2210%22%20fill%3D%22black%22%2F%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%2242%22%20r%3D%225.6%22%20fill%3D%22white%22%2F%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2261%22%20r%3D%225.8%22%20fill%3D%22black%22%2F%3E%3Ccircle%20cx%3D%2270%22%20cy%3D%2261%22%20r%3D%225.8%22%20fill%3D%22black%22%2F%3E%3C%2Fmask%3E%3C%2Fdefs%3E%3Cpath%20d%3D%22M12%2036%20Q12%2027%2020%2025%20Q50%2019%2080%2025%20Q88%2027%2088%2036%20V69%20Q88%2078%2079%2078%20H21%20Q12%2078%2012%2069%20Z%22%20mask%3D%22url%28%23m%29%22%2F%3E%3Cpath%20d%3D%22M8%2043%20H5%20Q1%2043%201%2047%20V61%20Q1%2065%205%2065%20H8%20Z%22%2F%3E%3Cpath%20d%3D%22M92%2043%20H95%20Q99%2043%2099%2047%20V61%20Q99%2065%2095%2065%20H92%20Z%22%2F%3E%3Crect%20x%3D%2248%22%20y%3D%2212%22%20width%3D%224%22%20height%3D%2210%22%2F%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%229%22%20r%3D%227.4%22%2F%3E%3Crect%20x%3D%2217.2%22%20y%3D%2218%22%20width%3D%222.8%22%20height%3D%228%22%2F%3E%3Ccircle%20cx%3D%2218.6%22%20cy%3D%2217%22%20r%3D%225%22%2F%3E%3Crect%20x%3D%2280%22%20y%3D%2218%22%20width%3D%222.8%22%20height%3D%228%22%2F%3E%3Ccircle%20cx%3D%2281.4%22%20cy%3D%2217%22%20r%3D%225%22%2F%3E%3C%2Fsvg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%2080%22%3E%3Cdefs%3E%3Cmask%20id%3D%22m%22%3E%3Crect%20width%3D%22100%22%20height%3D%2280%22%20fill%3D%22white%22%2F%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%2242%22%20r%3D%2210%22%20fill%3D%22black%22%2F%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%2242%22%20r%3D%225.6%22%20fill%3D%22white%22%2F%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2261%22%20r%3D%225.8%22%20fill%3D%22black%22%2F%3E%3Ccircle%20cx%3D%2270%22%20cy%3D%2261%22%20r%3D%225.8%22%20fill%3D%22black%22%2F%3E%3C%2Fmask%3E%3C%2Fdefs%3E%3Cpath%20d%3D%22M12%2036%20Q12%2027%2020%2025%20Q50%2019%2080%2025%20Q88%2027%2088%2036%20V69%20Q88%2078%2079%2078%20H21%20Q12%2078%2012%2069%20Z%22%20mask%3D%22url%28%23m%29%22%2F%3E%3Cpath%20d%3D%22M8%2043%20H5%20Q1%2043%201%2047%20V61%20Q1%2065%205%2065%20H8%20Z%22%2F%3E%3Cpath%20d%3D%22M92%2043%20H95%20Q99%2043%2099%2047%20V61%20Q99%2065%2095%2065%20H92%20Z%22%2F%3E%3Crect%20x%3D%2248%22%20y%3D%2212%22%20width%3D%224%22%20height%3D%2210%22%2F%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%229%22%20r%3D%227.4%22%2F%3E%3Crect%20x%3D%2217.2%22%20y%3D%2218%22%20width%3D%222.8%22%20height%3D%228%22%2F%3E%3Ccircle%20cx%3D%2218.6%22%20cy%3D%2217%22%20r%3D%225%22%2F%3E%3Crect%20x%3D%2280%22%20y%3D%2218%22%20width%3D%222.8%22%20height%3D%228%22%2F%3E%3Ccircle%20cx%3D%2281.4%22%20cy%3D%2217%22%20r%3D%225%22%2F%3E%3C%2Fsvg%3E") center / 100% 100% no-repeat;
    background: linear-gradient(100deg, #4c7ba6 40%, #9dbcd9 50%, #4c7ba6 60%) 0 0 / 300% 100%;
    animation: app-launch-shimmer 1.4s ease-in-out infinite;
  }
  @keyframes app-launch-give-up { to { opacity: 0; visibility: hidden; } }
  @keyframes app-launch-shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }
  @media (prefers-reduced-motion: reduce) { #app-launch i { animation: none; } }
  /* Phones: the top bar slides away while scrolling down and back on the way up (native_app.js,
     installHidingTopBar). The page keeps its room (--nav-space) while things that stick under
     the bar (top: var(--nav-h)) move up to the top. */
  @media (max-width: 1023.98px) {
    [data-shell-top] { transition: transform .25s ease; }
    html.shell-top-hidden { --nav-space: 56px; --nav-h: 0px; }
    html.shell-top-hidden [data-shell-top] { height: var(--nav-space); transform: translateY(-100%); }
  }
  /* Moving between pages: the top bar, bottom bar and sidebar hold still and only the page
     cross-fades (cross-document view transitions; where a web view lacks them, nothing changes) */
  @view-transition { navigation: auto; }
  [data-shell-top] { view-transition-name: shell-top; }
  .shell-bottom { view-transition-name: shell-bottom; }
  .shell-side { view-transition-name: shell-side; }
  ::view-transition-group(shell-top), ::view-transition-group(shell-bottom), ::view-transition-group(shell-side) { animation: none; }
  ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .16s; }
  @media (prefers-reduced-motion: reduce) { ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; } }
</style>
<script>try { if (!sessionStorage.getItem("hb-launched")) document.documentElement.classList.add("app-launching"); } catch (e) {}</script>
<% end %>
