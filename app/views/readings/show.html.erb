<% if Rails.env.development? %>
  <script type="module">
    import RefreshRuntime from "/vite-dev/@react-refresh";
    RefreshRuntime.injectIntoGlobalHook(window);
    window.$RefreshReg$ = () => { };
    window.$RefreshSig$ = () => (type) => type;
    window.__vite_plugin_react_preamble_installed__ = true;
  </script>
  <% end %>

    <%= vite_client_tag %>
      <%= vite_javascript_tag "topicificator.jsx" %>

        <style>
          html {
            color-scheme: autolight dark;
          }

          .container footer {
            display: none !important;
            width: 0 !important;
          }

          footer {
            min-height: auto !important;
          }
        </style>

        <div id="reading-show-root" class="w-screen min-h-screen" data-reading="<%= json_escape({
        id: @reading.id,
        title: @reading.title,
        source: @reading.source,
        user_id: @reading.user_id,
        host: @reading.host,
        meetingName: @reading.meetingName,
        meetingUrl: @reading.meetingUrl,
        meetingDate: @reading.meetingDate,
        meetingTime: @reading.meetingTime&.strftime('%H:%M:%S'),
        content_html: @reading.content&.body&.to_s,
        richer_content_html: @reading.richer_content&.body&.to_s,
        topic_html: @reading.topic&.body&.to_s,
        tags: @reading.tags.order(:title).map { |tag|
          { id: tag.id, title: tag.title, slug: tag.slug }
        }
      }.to_json) %>" data-current-user="<%= json_escape(current_user ? { id: current_user.id }.to_json : '{}') %>"></div>