<% if Rails.env.development? %>
  <script type="module">
    import RefreshRuntime from "/vite-dev/@react-refresh";
    RefreshRuntime.injectIntoGlobalHook(window);
    window.$RefreshReg$ = () => { };
    window.$RefreshSig$ = () => (type) => type;
    window.__vite_plugin_react_preamble_installed__ = true;
  </script>
  <% end %>

    <%= vite_client_tag %>
      <%= vite_javascript_tag "topicificator.jsx" %>

        <style>
          html {
            color-scheme: autolight dark;
          }

          .container footer {
            display: none !important;
            width: 0 !important;
          }

          footer {
            min-height: auto !important;
          }

          .reading-prose p {
            font-family: "Gentium Book Plus", serif !important;
            font-optical-sizing: auto;
          }
        </style>

        <div id="reading-show-root" class="w-full min-w-0 self-start min-h-screen" data-reading="<%= json_escape({
        id: @reading.id,
        title: @reading.title,
        published: @reading.published?,
        source: @reading.source,
        **@source,
        user_id: @reading.user_id,
        host: @reading.host,
        meetingName: @reading.meetingName,
        meetingUrl: @reading.meetingUrl,
        meetingDate: @reading.meetingDate,
        meetingTime: @reading.meetingTime&.strftime('%H:%M:%S'),
        content_html: (@reading.content&.body&.to_s unless @source[:text_locked]),
        richer_content_html: (@reading.richer_content&.body&.to_s unless @source[:text_locked]),
        topic_html: @reading.topic&.body&.to_s,
        tags: @reading.tags.order(:title).map { |tag|
          { id: tag.id, title: tag.title, slug: tag.slug }
        },
        group: reading_group_link(@reading, current_user),
        host_url: reading_host_url(@reading, current_user),
        polls: @reading.polls.map(&:token),
        adopted_from: (from = @reading.adopted_from) && from.visible_to?(current_user) ? {
          title: from.title, path: reading_path(from), meeting_name: from.meetingName, meeting_date: from.meetingDate&.iso8601
        } : nil,
        can_add_poll: Poll.attachable_to?(@reading, current_user)
      }.to_json) %>" data-current-user="<%= json_escape(current_user ? { id: current_user.id }.to_json : '{}') %>"></div>