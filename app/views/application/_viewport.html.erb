<meta name="viewport" content="width=device-width, initial-scale=1">
<%# iPhone and iPad Safari zoom the page in when a field under 16px is focused,
    and leave it zoomed. maximum-scale=1 stops that, and iOS still lets people
    pinch-zoom, so it's only added there (Android would lose pinch-zoom). %>
<script>
  (function () {
    var ua = navigator.userAgent;
    var iOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    if (!iOS) return;
    var meta = document.querySelector('meta[name="viewport"]');
    if (meta) meta.setAttribute("content", "width=device-width, initial-scale=1, maximum-scale=1");
  })();
</script>
