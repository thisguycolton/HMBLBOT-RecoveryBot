<% content_for(:page_title) { "RecoveryBot | Meetings, readings and tools for recovery groups" } %>
<% content_for(:head) do %>
  <% base = Rails.env.production? ? "https://#{request.host}" : request.base_url %>
  <script type="application/ld+json"><%= raw json_escape([
    { "@context": "https://schema.org", "@type": "WebSite", name: "RecoveryBot", url: "#{base}/", description: ShareMeta::SITE_DESCRIPTION },
    { "@context": "https://schema.org", "@type": "Organization", name: "RecoveryBot", url: "#{base}/", logo: "#{base}/apple-touch-icon.png" },
  ].to_json) %></script>
<% end %>
<script type="module">
  import RefreshRuntime from "/vite-dev/@react-refresh";
  RefreshRuntime.injectIntoGlobalHook(window);
  window.$RefreshReg$ = () => { };
  window.$RefreshSig$ = () => (type) => type;
  window.__vite_plugin_react_preamble_installed__ = true;
</script>


<%= vite_client_tag %>
<%= vite_javascript_tag 'topicificator.jsx' %>
<div id="home-root" class="w-full"></div>