<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Court verifications (<%= @court_verifications.size %>)</title>
  <style>
    body { margin: 0; background: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; max-width: 720px; margin: 0 auto; padding: 16px; color: #334155; font-size: 14px; }
    .toolbar button { background: #0e7490; color: #fff; border: 0; border-radius: 10px; padding: 8px 16px; font-size: 14px; font-weight: 600; cursor: pointer; }
    .letter { max-width: 720px; margin: 0 auto 16px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; }
    .empty { max-width: 720px; margin: 48px auto; text-align: center; color: #64748b; }
    @media print {
      body { background: #fff; }
      .toolbar { display: none; }
      .letter { border: 0; border-radius: 0; margin: 0; max-width: none; break-after: page; }
      .letter:last-child { break-after: auto; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <span><%= pluralize(@court_verifications.size, "verification") %>, one per page, oldest first.</span>
    <button type="button" onclick="window.print()">Print / Save as PDF</button>
  </div>
  <% if @court_verifications.empty? %>
    <p class="empty">No verifications match these filters.</p>
  <% end %>
  <% @court_verifications.each do |verification| %>
    <section class="letter">
      <%= render "court_verification_mailer/letter", verification: verification %>
    </section>
  <% end %>
</body>
</html>
