<%# One verification letter, worded like verification_email (CourtLetter). Inline styles so it works in
    email (bundle_email) and on paper (admin_panel/court_verifications/print). %>
<div style="padding:28px 32px; color:#111827; font-family:Georgia,'Times New Roman',serif; font-size:15px; line-height:1.6;">
  <p style="margin:0 0 4px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#0e7490;">
    <%= verification.group_label %> &middot; Meeting Attendance Verification
  </p>
  <% verification.letter.paragraphs.each do |lines| %>
    <p style="margin:16px 0 0;">
      <% lines.each_with_index do |(label, value), j| %>
        <%= tag.br if j.positive? %>
        <% if label %>
          <span style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.06em; color:#6b7280;"><%= label %>:</span>
          <%= value %>
        <% else %>
          <%= value %>
        <% end %>
      <% end %>
    </p>
  <% end %>
</div>
