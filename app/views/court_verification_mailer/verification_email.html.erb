<!DOCTYPE html>
<html>

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <title><%= @letter.subject %></title>
</head>

<body
  style="margin:0; padding:0; background-color:#0f172a; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td align="center" style="padding:24px 16px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
          style="max-width:640px; background-color:#111827; border-radius:12px; overflow:hidden; border:1px solid #1f2937;">
          <!-- Header bar -->
          <tr>
            <td style="background:linear-gradient(90deg,#0891b2,#22d3ee); padding:16px 24px; text-align:center;">
              <h1
                style="margin:0; font-size:20px; line-height:1.3; color:#ecfeff; letter-spacing:0.06em; text-transform:uppercase;">
                <%= @court_verification.group_label %>
              </h1>
              <p style="margin:4px 0 0; font-size:12px; color:#e0f2fe;">
                Meeting Attendance Verification
              </p>
            </td>
          </tr>

          <!-- Body: the group's wording (CourtLetter), filled in -->
          <tr>
            <td style="padding:24px; color:#e5e7eb; font-size:14px; line-height:1.6;">
              <% @letter.paragraphs.each_with_index do |lines, i| %>
                <p style="margin:<%= i.zero? ? 0 : 16 %>px 0 0 0;">
                  <% lines.each_with_index do |(label, value), j| %>
                    <%= tag.br if j.positive? %>
                    <% if label %>
                      <span style="font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#9ca3af;"><%= label %>:</span>
                      <span style="color:#f9fafb;"><%= value %></span>
                    <% else %>
                      <%= value %>
                    <% end %>
                  <% end %>
                </p>
              <% end %>
            </td>
          </tr>

          <!-- Footer note -->
          <tr>
            <td style="padding:16px 24px; background-color:#020617; text-align:center;">
              <p style="margin:0; font-size:11px; color:#6b7280;">
                This verification reflects attendance at an Alcoholics Anonymous meeting and is provided
                at the request of the participant.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>

</html>